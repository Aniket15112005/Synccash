rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function isCashbookMember(database, cashbookId) {
      let cb = get(/databases/$(database)/documents/cashbooks/$(cashbookId)).data;
      return request.auth != null
          && (request.auth.uid == cb.ownerId
              || request.auth.uid == cb.participantId);
    }

    // iOS PWA and web builds both run with kIsWeb = true in Flutter,
    // so their platform field is stored as anything other than "android".
    // Android native builds store platform = "android".
    function isIosUser(database) {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platform != "android";
    }

    // Bank transactions are iOS/PWA-only.
    function isBankTransaction(data) {
      return data.category == 'bank';
    }

    // CB (Cashbook) transactions are iOS/PWA-only.
    function isCbTransaction(data) {
      return data.category == 'cb';
    }

    // True when the category is restricted to iOS/PWA users (bank or cb).
    function isRestrictedCategory(data) {
      return isBankTransaction(data) || isCbTransaction(data);
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Cashbooks ──────────────────────────────────────────────────────────
    match /cashbooks/{cashbookId} {

      allow list: if request.auth != null;

      allow get: if request.auth != null
                 && (request.auth.uid == resource.data.ownerId
                     || request.auth.uid == resource.data.participantId);

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerId
                        || request.auth.uid == resource.data.participantId);

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;

      // ── Active Transactions ───────────────────────────────────────────────
      match /transactions/{transactionId} {

        // Individual document read: Android users cannot read bank or CB docs.
        // List/query reads: open to all members (Firestore can't restrict per-field
        // on collection queries; restricted UIs are hidden from Android so they
        // won't query those categories).
        allow get:  if isCashbookMember(database, cashbookId)
                    && (!isRestrictedCategory(resource.data) || isIosUser(database));
        allow list: if isCashbookMember(database, cashbookId);

        // Android: can only create entries where they are the creator AND
        //          cannot create bank or CB-category transactions.
        // iOS/web: can create any category, including restoring deleted entries
        //          with a different createdBy (recycle-bin restore).
        allow create: if isCashbookMember(database, cashbookId)
                      && (!isRestrictedCategory(request.resource.data) || isIosUser(database))
                      && (request.auth.uid == request.resource.data.createdBy
                          || isIosUser(database));

        // Update rules:
        //   1. Must be a cashbook member.
        //   2. Android users can only edit their OWN non-restricted entries.
        //      iOS/web users can edit any entry.
        //   3. The `createdBy` field may only be changed by iOS/web users.
        //   4. Android users cannot touch bank or CB-category transactions at all.
        allow update: if isCashbookMember(database, cashbookId)
                      && (!isRestrictedCategory(resource.data) || isIosUser(database))
                      && (!isRestrictedCategory(request.resource.data) || isIosUser(database))
                      && (request.auth.uid == resource.data.createdBy
                          || isIosUser(database))
                      && (request.resource.data.createdBy == resource.data.createdBy
                          || isIosUser(database));

        // Android: cannot delete anything.
        // iOS/web: can delete any entry (soft-delete moves it to recycle bin).
        allow delete: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
      }

      // ── Recycle Bin (deleted_transactions) ────────────────────────────────
      match /deleted_transactions/{transactionId} {

        // Both users can read — Android can see what was deleted
        // (useful if you ever want to show them a read-only view).
        allow read: if isCashbookMember(database, cashbookId);

        // iOS/web only: soft-delete writes the document here.
        allow create: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);

        // iOS/web only: permanent delete removes the document.
        allow delete: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
      }

      // ── Sale Bills ────────────────────────────────────────────────────────
      match /sale_bills/{billId} {

        // Both Android and iOS/PWA members can read all sale bills.
        allow read: if isCashbookMember(database, cashbookId);

        // Both Android and iOS/PWA members can create sale bills.
        allow create: if isCashbookMember(database, cashbookId);

        // Both Android and iOS/PWA members can update (e.g. settle a bill).
        allow update: if isCashbookMember(database, cashbookId);

        // Only iOS/PWA members can delete a bill.
        allow delete: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
      }

      // ── Purchase Bills ────────────────────────────────────────────────────
      // The entire purchases feature is iOS/PWA-only.
      // Android users are blocked from all operations at the Firestore level.
      match /purchase_bills/{billId} {
        allow read:   if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow create: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow update: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow delete: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
      }

      // ── Purchase Clients ──────────────────────────────────────────────────
      // iOS/PWA-only — mirrors the purchase_bills restriction.
      match /purchase_clients/{clientId} {
        allow read:   if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow create: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow update: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow delete: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
      }

      // ── Daily Entries ─────────────────────────────────────────────────────
      // The entire Daily feature is iOS/PWA/web-only.
      // Android users are blocked from all operations at the Firestore level,
      // mirroring the purchase_bills / purchase_clients restriction. This
      // collection is fully isolated from /transactions and never touches
      // the parent cashbook's totals.
      match /daily_entries/{entryId} {
        allow read:   if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow create: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow update: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow delete: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
      }

      // ── Daily Cards ────────────────────────────────────────────────────────
      // Sub-feature of Daily, fully isolated from /daily_entries and
      // /transactions. iOS/PWA/web-only, same restriction as Daily itself.
      match /daily_cards/{cardId} {
        allow read:   if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow create: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow update: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);
        allow delete: if isCashbookMember(database, cashbookId)
                      && isIosUser(database);

        // Each card's own transactions — scoped to this card only.
        match /transactions/{txId} {
          allow read:   if isCashbookMember(database, cashbookId)
                        && isIosUser(database);
          allow create: if isCashbookMember(database, cashbookId)
                        && isIosUser(database);
          allow update: if isCashbookMember(database, cashbookId)
                        && isIosUser(database);
          allow delete: if isCashbookMember(database, cashbookId)
                        && isIosUser(database);
        }
      }

      // ── Parties (Opening Balances) ────────────────────────────────────────
      match /parties/{partyId} {
        allow read:   if isCashbookMember(database, cashbookId);
        allow create: if isCashbookMember(database, cashbookId);
        allow update: if isCashbookMember(database, cashbookId);
        allow delete: if isCashbookMember(database, cashbookId);
      }

    }

  }
}
