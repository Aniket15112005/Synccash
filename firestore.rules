rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isCashbookMember(database, cashbookId) {
      let cb = get(/databases/$(database)/documents/cashbooks/$(cashbookId)).data;
      return request.auth != null
          && (request.auth.uid == cb.ownerId
              || request.auth.uid == cb.participantId);
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Cashbooks ──────────────────────────────────────────────────────────
    match /cashbooks/{cashbookId} {

      allow list: if request.auth != null;

      allow get: if request.auth != null
                 && (request.auth.uid == resource.data.ownerId
                     || request.auth.uid == resource.data.participantId);

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerId
                        || request.auth.uid == resource.data.participantId);

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;

      // ── Transactions ─────────────────────────────────────────────────────
      match /transactions/{transactionId} {
        allow read: if isCashbookMember(database, cashbookId);

        allow create: if isCashbookMember(database, cashbookId)
                      && request.auth.uid == request.resource.data.createdBy;

        // Android: only edit own entry.
        // iOS/web: can edit any entry in the cashbook.
        allow update: if isCashbookMember(database, cashbookId)
                      && (request.auth.uid == resource.data.createdBy
                          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platform != "android");

        // Android: cannot delete anything.
        // iOS/web: can delete any entry in the cashbook.
        allow delete: if isCashbookMember(database, cashbookId)
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platform != "android";
      }
    }

  }
}